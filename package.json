    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
