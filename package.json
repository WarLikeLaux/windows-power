{
  "name": "@warlikelaux/windows-power-mcp",
  "version": "0.1.0",
  "description": "MCP server for scheduling and managing Windows shutdowns from WSL.",
  "type": "module",
  "private": true,
  "bin": {
    "windows-power-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    ".codex-plugin",
    ".mcp.json",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
